  "parts": [
    {
      "id": "body_shell",
      "name": "车壳与腰线",
      "refs": [
        "side",
        "front_three_quarter",
        "prototype_side"
      ],
      "observations": [
        "低鼻楔形；前翼子板隆起后接沿侧面上扬的清晰肩线。",
        "门板主体是大平缓面，肩部有折线；风挡与车顶是连续弧面，不能把全车都画成平板楔块。",
        "后轮上方宽肩延伸到平直尖尾，车头比尾部低。"
      ],
      "confidence": "高：共用车壳轮廓；具体截面中等",
      "modeling": "独立截面放样车壳；肩线保留折痕，轮拱与玻璃边缘用平滑曲面。",
      "limits": "未提供CAD或正交三视图，不可据此宣布毫米级尺寸。"
    },
    {
      "id": "nose",
      "name": "车头与灯",
      "refs": [
        "front",
        "front_three_quarter"
      ],
      "observations": [
        "宽梯形中央鼻板，左右外侧为向内收的折角翼子板。",
        "前沿有细横向白灯线；隐藏灯位于两侧内收角，呈小型斜切灯腔。",
        "下部是黑色开口与贴近地面的薄分流唇，不是竖直厚保险杠。"
      ],
      "confidence": "高：轮廓与分区",
      "modeling": "中央鼻板、左右肩块、灯槽、黑色下腔和薄前唇分别建模。",
      "limits": "灯源数量/光学细节未知；可见亮斑不能当作灯珠数。"
    },
    {
      "id": "arches",
